{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true
  },
  "settings": {
    "react": {
      "version": "18.3.1"
    }
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "build/**"]
}
